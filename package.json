{
  "name": "accountable",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "seed": "uv run python -m backend.seed",
    "test": "node scripts/test-all.mjs",
    "test:trace": "node scripts/check-trace.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:backend": "uv run pytest -q",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
