# Settings for npm run dev, npm run build and npm start (RUN-13).
# Copy this file to .env and fill in the values from your Supabase project.
# .env is ignored by git. npm run dev:local and the tests don't use any of these.
# On Render, enter the same three in the service's Environment page instead.

# Postgres connection string: Supabase dashboard > Connect > Session pooler
# (the direct connection is IPv6 only, which Render can't reach).
# Put your database password in place of [YOUR-PASSWORD].
DATABASE_URL=

# The project's address: Project Settings > Data API > Project URL,
# for example https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The publishable key, safe in a browser: Project Settings > API Keys > Publishable key
# (starts with sb_publishable_). Never put the secret key here.
SUPABASE_PUBLISHABLE_KEY=
