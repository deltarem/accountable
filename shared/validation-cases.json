        { "set": { "name": "   " }, "valid": false, "field": "name", "message": "Enter a name" },
        { "set": { "name": null }, "valid": false, "field": "name", "message": "Enter a name" },
        { "set": { "name": { "repeat": "x", "times": 200 } }, "valid": true },
        { "set": { "name": { "repeat": "x", "times": 201 } }, "valid": false, "field": "name", "message": "Use 200 characters or fewer" },
        { "set": { "website": "acme.example" }, "valid": true },
        { "set": { "website": "https://acme.example" }, "valid": true },
        { "set": { "website": "" }, "valid": true },
        { "set": { "industry": "Software" }, "valid": true },
        { "set": { "notes": { "repeat": "n", "times": 5000 } }, "valid": true },
        { "set": { "notes": { "repeat": "n", "times": 5001 } }, "valid": false, "field": "notes", "message": "Use 5.000 characters or fewer" }
      ]
    },
